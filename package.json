{
  "author": "saivoora",
  "build": {
    "appId": "com.saivoora.flowtate",
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "README.md"
    ],
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "productName": "FlowTate",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@huggingface/transformers": "^4.3.1",
    "electron-store": "^8.2.0"
  },
  "description": "Local-first voice dictation for macOS, Windows and Linux \u2014 no accounts, no API keys",
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "main": "src/main.js",
  "name": "flowtate",
  "productName": "FlowTate",
  "scripts": {
    "dist": "electron-builder",
    "start": "electron ."
  },
  "version": "0.1.3"
}
